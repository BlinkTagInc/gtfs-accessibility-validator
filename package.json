{
  "name": "gtfs-accessibility-validator",
  "version": "0.3.8",
  "description": "Test GTFS for accessibility information",
  "keywords": [
    "transit",
    "gtfs",
    "transportation",
    "accessibility"
  ],
  "bugs": {
    "url": "https://github.com/blinktaginc/gtfs-accessibility-validator/issues"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/blinktaginc/gtfs-accessibility-validator.git"
  },
  "license": "MIT",
  "author": "Brendan Nee <brendan@blinktag.com>",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "bin": {
    "gtfs-accessibility-validator": "dist/bin/gtfs-accessibility-validator.js"
  },
  "scripts": {
    "prepare": "husky",
    "build": "tsdown",
    "test": "pnpm run build && node --test test/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cli-table": "^0.3.11",
    "color-contrast-checker": "^2.1.0",
    "gtfs": "5.0.0-beta.0",
    "lodash-es": "^4.18.1",
    "pretty-error": "^4.0.0",
    "yargs": "^18.2.0",
    "yoctocolors": "^2.2.0"
  },
  "devDependencies": {
    "@types/cli-table": "^0.3.4",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26",
    "@types/yargs": "^17.0.35",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "release-it": {
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/keep-a-changelog": {
        "filename": "CHANGELOG.md"
      }
    },
    "hooks": {
      "after:bump": "npm run build"
    }
  },
  "prettier": {
    "singleQuote": true
  },
  "lint-staged": {
    "*.js": "prettier --write",
    "*.ts": "prettier --write",
    "*.json": "prettier --write"
  },
  "packageManager": "pnpm@12.18.0"
}
