{
  "name": "gtfs-accessibility-validator",
  "version": "0.4.0",
  "description": "Validate accessibility information in GTFS Schedule feeds.",
  "keywords": [
    "transit",
    "gtfs",
    "transportation",
    "accessibility"
  ],
  "bugs": {
    "url": "https://github.com/blinktaginc/gtfs-accessibility-validator/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BlinkTagInc/gtfs-accessibility-validator.git"
  },
  "license": "MIT",
  "author": "Brendan Nee <brendan@blinktag.com>",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "CHANGELOG.md",
    "dist",
    "docs",
    "config-sample.json",
    "config-sample-full.json"
  ],
  "bin": {
    "gtfs-accessibility-validator": "dist/bin/gtfs-accessibility-validator.js"
  },
  "scripts": {
    "build": "tsdown",
    "build-watch": "tsdown --watch",
    "test": "pnpm run build && node --test test/integration/*.test.js test/unit/*.test.js",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "node .husky/install.mjs",
    "prepack": "npm run build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test:release": "pnpm run build && node --test test/package/*.test.js"
  },
  "dependencies": {
    "gtfs": "5.0.0-beta.0"
  },
  "devDependencies": {
    "@types/node": "^26",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "tsdown": "^0.23.7",
    "typescript": "7.1.0-beta",
    "oxlint": "1.93.0",
    "release-it": "^21.1.2",
    "@release-it/keep-a-changelog": "^8.0.1",
    "publint": "^0.3.25",
    "@arethetypeswrong/core": "^0.18.5"
  },
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "release-it": {
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/keep-a-changelog": {
        "filename": "CHANGELOG.md"
      }
    },
    "hooks": {
      "before:init": [
        "pnpm run lint",
        "pnpm run format:check",
        "pnpm run typecheck",
        "pnpm test",
        "pnpm run test:release"
      ],
      "after:bump": "pnpm run build"
    },
    "git": {
      "requireBranch": "main",
      "requireCommits": true,
      "commitMessage": "Release ${version}",
      "tagName": "${version}"
    },
    "npm": {
      "publish": true,
      "publishPackageManager": "pnpm",
      "publishArgs": [
        "--no-git-checks"
      ]
    }
  },
  "prettier": {
    "singleQuote": true
  },
  "lint-staged": {
    "*.{js,mjs,ts,json,md,yml,yaml}": "prettier --write"
  },
  "packageManager": "pnpm@12.18.0",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  }
}
